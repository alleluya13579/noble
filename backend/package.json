{
  "name": "@noble/backend",
  "version": "0.1.0",
  "private": true,
  "description": "Noble core: transaction process, schema and API contract",
  "type": "module",
  "engines": { "node": ">=20" },
  "scripts": {
    "start": "node src/server.js",
    "dev": "NOBLE_ENV=development node --watch src/server.js",
    "test": "node --test test/*.test.js",
    "test:pg": "TEST_DATABASE_URL=${TEST_DATABASE_URL:-postgres://postgres@127.0.0.1:5432/noble_test} node --test test/*.test.js"
  },
  "optionalDependencies": {
    "pg": "^8.23.1"
  }
}
