# Noble backend configuration.
# Copy to .env and fill in what you have. Every provider is optional: with no key, that provider runs
# in SANDBOX mode (simulated, logged, never charges or sends anything) so the whole system works end to end.
# GET /admin/integrations shows which providers are live and which are still sandboxed.

# ---------- Server ----------
PORT=8080
NOBLE_ENV=development                 # development | production. In development, OTP codes are returned in the API response.
DATABASE_PATH=./data/noble.sqlite     # SQLite file (zero setup). Ignored when DATABASE_URL is set.
DATABASE_URL=                         # PostgreSQL, e.g. postgres://noble:secret@db.example.com:5432/noble (needs `npm install pg`). schema.sql is applied on start.
UPLOAD_DIR=./data/uploads
PUBLIC_BASE_URL=http://localhost:8080 # Used to build webhook callback URLs given to providers.
SESSION_SECRET=change-me-to-a-long-random-string
DOCS_ENCRYPTION_KEY=                  # 32 bytes, hex (64 chars). Encrypts ownership documents at rest. Generated and printed if empty in development.
ID_HASH_SECRET=change-me-too          # HMAC key for hashing ID document numbers (duplicate-account detection).
ADMIN_PHONES=+254700000000            # Comma-separated E.164 numbers that log in as admin.
CORS_ORIGINS=*                        # In production: the web app origin(s), comma-separated, e.g. https://app.noble.example
TRUST_PROXY=false                     # true behind a load balancer / reverse proxy (reads X-Forwarded-For, sets HSTS)
LOG_FORMAT=text                       # text | json (one JSON object per line, with request ids)
MAX_UPLOAD_MB=8                       # Largest photo or document accepted
IP_RATE_LIMIT_PER_MIN=300             # Requests per minute per client address (first line of defence; business limits are per account)
METRICS_TOKEN=                        # If set, GET /metrics requires "Authorization: Bearer <token>"
# In production (NOBLE_ENV=production) the server refuses to start until SESSION_SECRET, ID_HASH_SECRET,
# DOCS_ENCRYPTION_KEY, PUBLIC_BASE_URL (https), CORS_ORIGINS and ADMIN_PHONES are set properly.

# ---------- Payments (fill the ones for your countries) ----------
# Safaricom M-Pesa Daraja (Kenya). https://developer.safaricom.co.ke
MPESA_ENV=sandbox                     # sandbox | production
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=
MPESA_PASSKEY=
MPESA_B2C_INITIATOR=
MPESA_B2C_SECURITY_CREDENTIAL=

# Paystack (Nigeria, Ghana, South Africa, Kenya). https://paystack.com/docs
PAYSTACK_SECRET_KEY=

# Flutterwave (MTN MoMo, Airtel Money, Tigo Pesa, cards across Africa). https://developer.flutterwave.com
FLUTTERWAVE_SECRET_KEY=
FLUTTERWAVE_WEBHOOK_HASH=

# Stripe (UK, US, EU; manual capture for holds, Connect for payouts). https://stripe.com/docs
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Which provider handles which payment method. Defaults are sensible; override as PAYMENT_PROVIDER_<METHOD>=<provider>.
# Methods: mpesa, mpesa_tz, airtel_money, mtn_momo, tigo_pesa, card, bank_transfer, ussd, eft, open_banking, ach
# Providers: mpesa, paystack, flutterwave, stripe, sandbox
# PAYMENT_PROVIDER_CARD=paystack

# ---------- Identity (KYC) ----------
# Smile Identity (Africa). https://docs.usesmileid.com
SMILE_ID_PARTNER_ID=
SMILE_ID_API_KEY=
SMILE_ID_ENV=sandbox
# Onfido (global). https://documentation.onfido.com
ONFIDO_API_TOKEN=
ONFIDO_WEBHOOK_TOKEN=
# Which KYC provider per country, e.g. KYC_PROVIDER_KE=smile_id, KYC_PROVIDER_GB=onfido. Default: smile_id for African countries, onfido elsewhere.
KYC_SANDBOX_AUTO_VERIFY=true          # In sandbox, verify immediately so the flow can be tested.

# ---------- SMS ----------
# Africa's Talking. https://developers.africastalking.com
AFRICASTALKING_USERNAME=
AFRICASTALKING_API_KEY=
AFRICASTALKING_SENDER_ID=
# Twilio. https://www.twilio.com/docs
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

# ---------- Maps ----------
MAPBOX_TOKEN=                         # Geocoding and reverse geocoding. Without it, the country's centre is used.

# ---------- Storage ----------
# Default: local disk under UPLOAD_DIR. For S3-compatible storage fill these in.
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=
